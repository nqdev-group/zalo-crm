graph TB
    subgraph FE["Frontend components"]
        VIEWS["Views (51)"]
        COMPOSABLES["Composables (40+ use-*.ts)"]
        STORES["Pinia stores: auth, rbac, privacy"]
        APIL["api/index.ts (shared axios)<br/>+ media.ts, public-branding.ts, socket.ts"]
    end

    subgraph BE["Backend components"]
        ROUTES["Route modules (25)"]
        SVC["Service layer"]
        TENANT["tenant-context.ts / tenant-guard.ts"]
        EEREG["ee-registry/* (no-op hook defaults)"]
        PRISMA["Prisma client<br/>4-layer $extends chain"]
    end

    subgraph EE_ABSENT["EE bundle (absent in this checkout)"]
        EEMOD["_ee/automation, _ee/lead-pool, _ee/facebook<br/>(schema present, logic absent)"]
    end

    VIEWS --> COMPOSABLES
    COMPOSABLES --> STORES
    COMPOSABLES --> APIL
    APIL -- "REST + Socket.IO" --> ROUTES
    ROUTES --> SVC
    SVC --> TENANT
    TENANT --> PRISMA
    SVC -.->|"hook call, no-op if absent"| EEREG
    EEREG -.->|"would be overridden by"| EEMOD

    classDef fe fill:#d6eaf8,stroke:#2980b9
    classDef be fill:#d4edda,stroke:#27ae60
    classDef absent fill:#f2f2f2,stroke:#999,stroke-dasharray: 5 5
    class VIEWS,COMPOSABLES,STORES,APIL fe
    class ROUTES,SVC,TENANT,EEREG,PRISMA be
    class EEMOD absent
</content>
